{
  "info": {
    "_postman_id": "etamid-api-v1",
    "name": "اعْتَمِدْ (Etamid) API - v1",
    "description": "مجموعة طلبات Postman الرسمية لمنصة اعْتَمِدْ (Etamid) - جاهزة للاختبار لتيم الموبايل والويب",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5080/api/v1",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "testPhone",
      "value": "0501234567",
      "type": "string"
    },
    {
      "key": "testEmail",
      "value": "hossamahsalama@gmail.com",
      "type": "string"
    },
    {
      "key": "testPassword",
      "value": "Pass#123",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. فحص السيرفر (System Ping)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept-Language", "value": "ar" }
        ],
        "url": {
          "raw": "{{baseUrl}}/system/ping",
          "host": ["{{baseUrl}}"],
          "path": ["system", "ping"]
        }
      }
    },
    {
      "name": "1. تسجيل أفراد (Register Individual)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 201', function () {",
              "    pm.response.to.have.status(201);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept-Language", "value": "ar" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"حسام سلامة\",\n  \"phone\": \"{{testPhone}}\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"acceptTerms\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/register/individual",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "register", "individual"]
        }
      }
    },
    {
      "name": "2. تسجيل شركة (Register Company)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept-Language", "value": "ar" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"companyName\": \"شركة تقنية المستقبل\",\n  \"ownerPhone\": \"0555555555\",\n  \"commercialRegNo\": \"1010123456\",\n  \"taxNo\": \"300123456700003\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"acceptTerms\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/register/company",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "register", "company"]
        }
      }
    },
    {
      "name": "3. تفعيل البريد بكود OTP (Verify Email OTP)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    var res = pm.response.json();",
              "    if (res.data && res.data.accessToken) {",
              "        pm.collectionVariables.set('accessToken', res.data.accessToken);",
              "        pm.collectionVariables.set('refreshToken', res.data.refreshToken);",
              "        console.log('Saved accessToken & refreshToken to collection variables');",
              "    }",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept-Language", "value": "ar" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone\": \"{{testPhone}}\",\n  \"code\": \"123456\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/otp/verify",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "otp", "verify"]
        },
        "description": "ضع كود الـ 6 أرقام الحقيقي الواصل لإيميلك، أو كود التطوير 123456"
      }
    },
    {
      "name": "4. إعادة إرسال رمز التحقق (Resend OTP)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept-Language", "value": "ar" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone\": \"{{testPhone}}\",\n  \"purpose\": \"register\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/otp/resend",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "otp", "resend"]
        }
      }
    },
    {
      "name": "5. تسجيل الدخول (Login)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    var res = pm.response.json();",
              "    if (res.data && res.data.accessToken) {",
              "        pm.collectionVariables.set('accessToken', res.data.accessToken);",
              "        pm.collectionVariables.set('refreshToken', res.data.refreshToken);",
              "        console.log('Saved accessToken & refreshToken to collection variables');",
              "    }",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept-Language", "value": "ar" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone\": \"{{testPhone}}\",\n  \"password\": \"{{testPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "login"]
        }
      }
    },
    {
      "name": "6. الملف الشخصي للمستخدم الحالي (/me)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "Accept-Language", "value": "ar" }
        ],
        "url": {
          "raw": "{{baseUrl}}/me",
          "host": ["{{baseUrl}}"],
          "path": ["me"]
        }
      }
    },
    {
      "name": "7. تجديد الجلسة (Refresh Token)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    var res = pm.response.json();",
              "    if (res.data && res.data.accessToken) {",
              "        pm.collectionVariables.set('accessToken', res.data.accessToken);",
              "        pm.collectionVariables.set('refreshToken', res.data.refreshToken);",
              "    }",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept-Language", "value": "ar" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/refresh",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "refresh"]
        }
      }
    },
    {
      "name": "8. تسجيل الخروج (Logout)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept-Language", "value": "ar" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/logout",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "logout"]
        }
      }
    },
    {
      "name": "9. الشروط والأحكام (Platform Terms)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept-Language", "value": "ar" }
        ],
        "url": {
          "raw": "{{baseUrl}}/terms/platform",
          "host": ["{{baseUrl}}"],
          "path": ["terms", "platform"]
        }
      }
    }
  ]
}
