# Copy this file to .env and replace every value marked REPLACE.
# Never commit or send the real .env file.
MSSQL_SA_PASSWORD=REPLACE_WITH_STRONG_RANDOM_PASSWORD
JWT_SECRET=REPLACE_WITH_RANDOM_BASE64_SECRET
DATA_PROTECTION_KEY=REPLACE_WITH_RANDOM_BASE64_32_BYTE_KEY

# Local API port on the Windows host.
API_PORT=5080
MSSQL_PORT=1433

# For iOS devices on the same Wi-Fi, replace localhost with the Windows PC LAN IP.
# Example: http://192.168.1.25:5080/files
API_PUBLIC_BASE_URL=http://localhost:5080/files
