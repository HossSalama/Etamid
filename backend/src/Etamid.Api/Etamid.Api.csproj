<Project Sdk="Microsoft.NET.Sdk.Web"><PropertyGroup>  <UserSecretsId>4120417d-41b9-44fc-928f-9c540529f827</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Etamid.Application\Etamid.Application.csproj" />
    <ProjectReference Include="..\Etamid.Infrastructure\Etamid.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Seq" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <Content Update="Resources\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- Generated from Etamid_API.postman_collection.json; served at /collection-openapi.json
         and listed as a second definition in Swagger UI. The SDK already includes the file
         as Content, so Update (not Include) only sets the copy behaviour, so the endpoint
         works both from `dotnet run` and from a built DLL. -->
    <Content Update="Swagger\collection-openapi.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
